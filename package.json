{
  "name": "a2ui-openui-demo",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:offline": "npm run typecheck && npm run test && npm run test:e2e",
    "dev": "vite",
    "verify:live": "node --experimental-strip-types scripts/verify-live.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@open-pencil/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@openuidev/react-lang": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
